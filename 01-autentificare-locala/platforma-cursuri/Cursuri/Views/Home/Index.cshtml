@{
    ViewData["Title"] = "Home";
}

<section class="u-hero">
    <svg class="u-hero-mark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M2 4h6a4 4 0 0 1 4 4v13a3 3 0 0 0-3-3H2ZM22 4h-6a4 4 0 0 0-4 4v13a3 3 0 0 1 3-3h7Z" /></svg>
    <div class="u-eyebrow">Universitatea (demo)</div>
    <h1>Cursuri</h1>
    <p>Online courses of the university.</p>
    <form asp-controller="People" asp-action="Find" method="get" class="row g-2 mt-3">
        <div class="col-auto">
            <input name="username" class="form-control" size="30" placeholder="Username, e.g. ana.popescu" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-light">Find a person</button>
        </div>
    </form>
</section>
