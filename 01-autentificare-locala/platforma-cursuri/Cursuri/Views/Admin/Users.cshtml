@using Cursuri.Controllers
@model IEnumerable<UserRow>
@{
    ViewData["Title"] = "Users";
}

<div class="u-page-head">
    <div>
        <div class="u-eyebrow">Administration</div>
        <h1>Users</h1>
        <p>Every platform account, checked live against the Secretariat registry.</p>
    </div>
</div>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success">@message</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="card u-table-card">
    <table class="table table-hover align-middle">
        <thead>
            <tr><th>Username</th><th>Name</th><th>Origin</th><th>Matricol</th><th>Secretariat check</th><th>Role</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var row in Model)
            {
                var username = row.Account.IdentifierIn(Contexts.Cursuri);
                var check = row.SecretariatCheck switch
                {
                    "Matches" => "u-pill-success",
                    "Name differs" => "u-pill-warning",
                    "Unknown matricol" => "u-pill-danger",
                    _ => "",
                };
                <tr>
                    <td class="u-id">@username</td>
                    <td>@row.Account.Attribute("nume")</td>
                    <td><span class="u-pill @(row.Origin == "seeded" ? "u-pill-muted" : "u-pill-accent")">@row.Origin</span></td>
                    <td class="u-id">@(row.Account.IdentifierIn(Contexts.Secretariat) ?? "-")</td>
                    <td>
                        @if (check == "")
                        {
                            @row.SecretariatCheck
                        }
                        else
                        {
                            <span class="u-pill @check">@row.SecretariatCheck</span>
                        }
                    </td>
                    <td>
                        <form asp-action="SetRole" method="post" class="d-flex gap-1">
                            <input type="hidden" name="username" value="@username" />
                            <select name="role" class="form-select form-select-sm">
                                @foreach (var role in AdminController.Roles)
                                {
                                    <option selected="@(role == row.Account.Attribute("rol"))">@role</option>
                                }
                            </select>
                            <button type="submit" class="btn btn-sm btn-outline-primary">Save</button>
                        </form>
                    </td>
                    <td class="text-end">
                        <div class="d-flex gap-1 justify-content-end">
                            <form asp-action="ResetPassword" method="post">
                                <input type="hidden" name="username" value="@username" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Reset password</button>
                            </form>
                            <form asp-action="Delete" method="post" onsubmit="return confirm('Delete @username?')">
                                <input type="hidden" name="username" value="@username" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
