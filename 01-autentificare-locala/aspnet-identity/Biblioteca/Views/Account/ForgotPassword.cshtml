@model EmailViewModel
@{
    ViewData["Title"] = "Am uitat parola";
}

<h1>Am uitat parola</h1>
<p class="text-muted">Primești prin email un link cu care îți alegi o parolă nouă. Linkul expiră într-o oră.</p>

<div class="row">
    <div class="col-md-4">
        <form asp-action="ForgotPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Trimite linkul</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
