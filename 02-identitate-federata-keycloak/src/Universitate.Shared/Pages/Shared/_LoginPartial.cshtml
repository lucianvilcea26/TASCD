@* Shared login/logout widget used in both apps' navigation bars. *@
@if (User.Identity?.IsAuthenticated == true)
{
    var roles = string.Join(", ", User.FindAll(TokenClaims.RoleClaim).Select(c => c.Value));
    var fullName = User.FindFirst("name")?.Value ?? User.Identity.Name;
    <div class="u-user">
        <span class="u-avatar" title="@fullName">@Icons.Initials(fullName)</span>
        <span class="navbar-text">
            @fullName
            <small>@User.Identity.Name @if (roles.Length > 0) { <span>· @roles</span> }</small>
        </span>
        <span class="u-divider d-none d-md-block"></span>
        <a class="btn btn-sm btn-ghost" href="/Debug/Token" title="Inspect the tokens this app received">@Icons.Svg("code") Token</a>
        <form method="post" action="/account/logout" class="m-0">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-sm btn-outline-secondary">@Icons.Svg("logout") Log out</button>
        </form>
    </div>
}
else
{
    <a class="btn btn-primary"
       href="/account/login?returnUrl=@Uri.EscapeDataString(Context.Request.Path + Context.Request.QueryString)">@Icons.Svg("login") Log in</a>
}
