@page
@model Universitate.Shared.Pages.Debug.TokenModel
@{
    ViewData["Title"] = "Token inspector";
    var now = DateTimeOffset.UtcNow;
}
<h1 class="h3">Token inspector</h1>
<p class="text-muted">
    What this app received from Keycloak for <strong>@User.Identity?.Name</strong>.
    The tokens travel in the app's own cookie, encrypted with keys only the app has and marked HttpOnly: the browser stores it but can neither read the tokens nor hand them to JavaScript.
</p>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header">Claims the app uses (<code>User.Claims</code>)</div>
            <ul class="list-group list-group-flush small">
                @foreach (var c in User.Claims)
                {
                    <li class="list-group-item"><code>@c.Type</code> = @c.Value</li>
                }
            </ul>
            <div class="card-footer small text-muted">
                Built from the ID token at login and rebuilt at every refresh.
                Refresh token present: <strong>@(Model.HasRefreshToken ? "yes" : "no")</strong>.
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        @foreach (var t in Model.Tokens)
        {
            var left = t.ExpiresAt - now;
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between flex-wrap gap-2">
                    <span><strong>@t.Name</strong> <span class="text-muted small">aud: <code>@t.Audience</code></span></span>
                    <span class="small">
                        issued @t.IssuedAt?.ToLocalTime().ToString("HH:mm:ss") ·
                        @if (left > TimeSpan.Zero)
                        {
                            <span>expires in @((int)left.Value.TotalSeconds) s</span>
                        }
                        else
                        {
                            <span class="text-danger">expired (refreshed on next request)</span>
                        }
                    </span>
                </div>
                <pre class="m-0 p-3 small bg-body-tertiary" style="max-height: 28rem; overflow: auto;">@t.Payload</pre>
            </div>
        }
    </div>
</div>
