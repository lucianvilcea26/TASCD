@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}
<section class="u-hero mb-4">
    <svg class="u-hero-mark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M22 10 12 5 2 10l10 5 10-5ZM6 12.5V17c3.5 2.5 8.5 2.5 12 0v-4.5" /></svg>
    <div class="u-eyebrow" style="color: rgba(255,255,255,.75)">Universitatea (demo)</div>
    <h1>Secretariat</h1>
    <p>The student registry. It is the <strong>source of truth</strong> for who is a student;
        Keycloak only receives a copy of what it needs for login and tokens.</p>

    @if (User.Identity?.IsAuthenticated != true)
    {
        <a class="btn btn-light btn-lg mt-2" href="/account/login">@Icons.Svg("login") Log in with Keycloak</a>
        <p class="mt-3 mb-0 small" style="color: rgba(255,255,255,.75)">Staff: <code>secretara</code>. Students: use the invitation email (see Mailpit).</p>
    }
    else if (User.IsInRole("secretary"))
    {
        <div class="d-flex flex-wrap gap-2 mt-2">
            <a class="btn btn-light" asp-page="/Students/Index">@Icons.Svg("users") Manage students</a>
            <a class="btn btn-outline-light" asp-page="/Students/Create">@Icons.Svg("user-plus") Add a student</a>
        </div>
    }
    else if (User.IsInRole("student"))
    {
        <a class="btn btn-light mt-2" asp-page="/Me">@Icons.Svg("file") See my record</a>
    }
</section>

@if (User.IsInRole("secretary"))
{
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3"><div class="card u-stat">
            <div class="u-stat-label">Students</div><div class="u-stat-value">@Model.Total</div><div class="u-stat-note">in the registry</div>
        </div></div>
        <div class="col-6 col-lg-3"><div class="card u-stat">
            <div class="u-stat-label">Enrolled</div><div class="u-stat-value text-success">@Model.Enrolled</div><div class="u-stat-note">may use university services</div>
        </div></div>
        <div class="col-6 col-lg-3"><div class="card u-stat">
            <div class="u-stat-label">Suspended</div><div class="u-stat-value text-danger">@Model.Suspended</div><div class="u-stat-note">enrollment on hold</div>
        </div></div>
        <div class="col-6 col-lg-3"><div class="card u-stat">
            <div class="u-stat-label">Without account</div><div class="u-stat-value">@Model.NotProvisioned</div><div class="u-stat-note">not yet in Keycloak</div>
        </div></div>
    </div>
}

<div class="row g-3">
    <div class="col-md-4">
        <div class="card u-feature">
            <div class="u-feature-ico">@Icons.Svg("server")</div>
            <h2>Registers users in the IdP</h2>
            <p>Creating a student here calls the Keycloak <strong>Admin REST API</strong> as the
                Secretariat's service account. The Keycloak admin console is just another client of the same API.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card u-feature">
            <div class="u-feature-ico">@Icons.Svg("mail")</div>
            <h2>Invites, doesn't trust self-registration</h2>
            <p>Names and student IDs come from the registry and are read-only for students.
                The emailed link proves the student controls the address on record; then they set a password and an authenticator app.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card u-feature">
            <div class="u-feature-ico">@Icons.Svg("books")</div>
            <h2>Answers Biblioteca</h2>
            <p><code>GET /api/students/{id}/enrollment</code> returns the current status, for callers
                holding a token with audience <code>secretariat-api</code> and role <code>enrollment.read</code>.</p>
        </div>
    </div>
</div>
