@page "{id:int}"
@model Secretariat.Web.Pages.Students.EditModel
@{
    var s = Model.Student;
    var a = Model.Account;
    ViewData["Title"] = s.FullName;
    ViewData["LockStudentId"] = true;
}
<div class="u-page-head">
    <div class="u-person">
        <span class="u-avatar lg">@Icons.Initials(s.FullName)</span>
        <div>
            <div class="u-eyebrow mb-1"><a asp-page="Index">Students</a> / <span class="u-id">@s.StudentId</span></div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <h1>@s.FullName</h1>
                <span class="@Ui.StatusBadge(s.Status)">@s.Status.ToClaimValue()</span>
            </div>
            <div class="u-sub">@s.Email · @s.Faculty</div>
        </div>
    </div>
</div>

<partial name="_ApiCallsHistory" model="s" />
@if (s.LastSyncError is not null)
{
    <div class="alert alert-danger"><span><strong>Keycloak is out of sync with the registry.</strong> @s.LastSyncError</span></div>
}

<div class="row g-4">
    <div class="col-lg-7">
        <form method="post" asp-page-handler="Save" asp-route-id="@s.Id" class="card">
            <div class="card-header">Registry data <span class="text-muted small fw-normal">(Secretariat database)</span></div>
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <partial name="_StudentFields" for="Input" />
                <div class="form-check mt-3">
                    <input asp-for="RevokeSessions" class="form-check-input" />
                    <label asp-for="RevokeSessions" class="form-check-label">
                        Also end the student's Keycloak sessions (forces a new login, so new tokens carry the change immediately)
                    </label>
                </div>
            </div>
            <div class="card-footer d-flex gap-2">
                <button type="submit" class="btn btn-primary">@Icons.Svg("check") Save and publish to Keycloak</button>
                <a asp-page="Index" class="btn btn-ghost">Back to list</a>
            </div>
        </form>
    </div>

    <div class="col-lg-5">
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Keycloak account <span class="text-muted small fw-normal">(live, Admin API)</span></span>
                @if (a is not null) { <span class="u-pill @(a.Enabled ? "u-pill-success" : "u-pill-muted")">@(a.Enabled ? "enabled" : "disabled")</span> }
            </div>
            @if (s.KeycloakUserId is null)
            {
                <div class="card-body">
                    <p>No account in Keycloak yet.</p>
                    <form method="post" asp-page-handler="Provision" asp-route-id="@s.Id">
                        <button class="btn btn-primary">Create Keycloak account and send invitation</button>
                    </form>
                </div>
            }
            else if (Model.AccountError is not null)
            {
                <div class="card-body text-danger">@Model.AccountError</div>
            }
            else if (a is null)
            {
                <div class="card-body">
                    <p class="text-danger mb-0">The registry points to Keycloak user <code>@s.KeycloakUserId</code>, which no longer exists
                        (deleted in the admin console?).</p>
                </div>
            }
            else
            {
                <ul class="u-kv">
                    <li><span class="k">User id</span><span class="v"><code>@s.KeycloakUserId</code></span></li>
                    <li><span class="k">Username</span><span class="v"><code>@s.StudentId.ToLowerInvariant()</code> <span class="text-muted fw-normal small">or the email</span></span></li>
                    <li><span class="k">Invitation sent</span><span class="v">@Ui.Local(s.InvitedAtUtc)</span></li>
                    <li><span class="k">Email verified</span><span class="v"><span class="u-check @(a.EmailVerified ? "" : "no")">@Icons.Svg(a.EmailVerified ? "check" : "clock") @(a.EmailVerified ? "yes" : "not yet")</span></span></li>
                    <li><span class="k">Password set</span><span class="v"><span class="u-check @(a.HasPassword ? "" : "no")">@Icons.Svg(a.HasPassword ? "check" : "clock") @(a.HasPassword ? "yes" : "not yet")</span></span></li>
                    <li><span class="k">Authenticator app (TOTP)</span><span class="v"><span class="u-check @(a.HasOtp ? "" : "no")">@Icons.Svg(a.HasOtp ? "check" : "clock") @(a.HasOtp ? "registered" : "not yet")</span></span></li>
                    <li><span class="k">Pending required actions</span><span class="v">
                        @if (a.RequiredActions.Count == 0)
                        {
                            <span>none</span>
                        }
                        else
                        {
                            <code>@string.Join(", ", a.RequiredActions)</code>
                        }
                    </span></li>
                    <li><span class="k">Active sessions</span><span class="v">@a.ActiveSessions</span></li>
                </ul>
                <div class="card-footer d-flex flex-wrap gap-2">
                    <form method="post" asp-page-handler="Resend" asp-route-id="@s.Id">
                        <button class="btn btn-sm btn-outline-primary">@Icons.Svg("mail") Resend invitation</button>
                    </form>
                    <form method="post" asp-page-handler="Revoke" asp-route-id="@s.Id">
                        <button class="btn btn-sm btn-outline-warning">@Icons.Svg("ban") End all sessions</button>
                    </form>
                    <a class="btn btn-sm btn-outline-secondary" href="@Model.AdminConsoleLink" target="_blank">Same user in admin console @Icons.Svg("external")</a>
                </div>
            }
        </div>

        <div class="card">
            <div class="card-body d-flex justify-content-between align-items-center gap-3">
                <div class="small text-muted">Removes the student from the registry and deletes the Keycloak account.</div>
                <form method="post" asp-page-handler="Delete" asp-route-id="@s.Id"
                      onsubmit="return confirm('Delete this student from the registry and from Keycloak?');">
                    <button class="btn btn-sm btn-outline-danger text-nowrap">Delete student (registry + Keycloak)</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
