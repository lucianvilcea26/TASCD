@model Secretariat.Web.Pages.Students.StudentInput
<div class="row g-3">
    <div class="col-md-4">
        <label asp-for="StudentId" class="form-label"></label>
        <input asp-for="StudentId" class="form-control" placeholder="S2026001" readonly="@(ViewData["LockStudentId"] is true)" />
        <span asp-validation-for="StudentId" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="FirstName" class="form-label"></label>
        <input asp-for="FirstName" class="form-control" />
        <span asp-validation-for="FirstName" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="LastName" class="form-label"></label>
        <input asp-for="LastName" class="form-control" />
        <span asp-validation-for="LastName" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Faculty" class="form-label"></label>
        <input asp-for="Faculty" class="form-control" list="faculties" />
        <datalist id="faculties">
            <option>Cybernetics and Economic Informatics</option>
            <option>Finance and Banking</option>
            <option>Marketing</option>
            <option>International Business</option>
        </datalist>
        <span asp-validation-for="Faculty" class="text-danger small"></span>
    </div>
    <div class="col-md-2">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<EnrollmentStatus>()"></select>
    </div>
</div>
