@page
@model Secretariat.Web.Pages.MeModel
@{
    ViewData["Title"] = "My record";
    var s = Model.Student;
}
<h1 class="h3">My record</h1>

@if (s is null)
{
    <div class="alert alert-warning">
        Your token's <code>student_id</code> claim is <code>@(Model.StudentIdClaim ?? "missing")</code>,
        but there is no such student in the registry.
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">Registry data</div>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">Student ID: <code>@s.StudentId</code></li>
                    <li class="list-group-item">Name: @s.FullName</li>
                    <li class="list-group-item">Email: @s.Email</li>
                    <li class="list-group-item">Faculty: @s.Faculty</li>
                    <li class="list-group-item">Status: <span class="badge @Ui.StatusBadge(s.Status)">@s.Status.ToClaimValue()</span></li>
                </ul>
                <div class="card-footer small text-muted">
                    Wrong data? Only the Secretariat can change it. In Keycloak these fields are read-only for you
                    (user profile permissions: edit = admin).
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card border-@(s.Status == EnrollmentStatus.Enrolled ? "success" : "danger")">
                <div class="card-header">Enrollment certificate (adeverință)</div>
                <div class="card-body">
                    @if (s.Status == EnrollmentStatus.Enrolled)
                    {
                        <p>This certifies that <strong>@s.FullName</strong> (<code>@s.StudentId</code>) is enrolled at the
                            Faculty of @s.Faculty for the current academic year.</p>
                        <p class="small text-muted mb-0">Issued @DateTime.Now.ToString("yyyy-MM-dd HH:mm") from the live registry.</p>
                    }
                    else
                    {
                        <p class="mb-0">No certificate can be issued: your status is <strong>@s.Status.ToClaimValue()</strong>.</p>
                    }
                </div>
            </div>
        </div>
    </div>
}
