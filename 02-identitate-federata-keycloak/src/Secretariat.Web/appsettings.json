    "InvitationLifespanSeconds": 259200,
    "AdminConsoleUrl": "http://localhost:8080/admin/master/console/"
  },
  "Links": {
    "Secretariat": "http://localhost:5001/",
    "Biblioteca": "http://localhost:5002/",
    "AdminConsole": "http://localhost:8080/admin/master/console/#/universitate",
    "Mailpit": "http://localhost:8025"
  }
