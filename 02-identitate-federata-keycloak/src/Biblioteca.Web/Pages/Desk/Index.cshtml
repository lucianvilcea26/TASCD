@page
@model Biblioteca.Web.Pages.Desk.IndexModel
@{
    ViewData["Title"] = "Lending desk";
    var check = Model.LastCheck;
}
<div class="u-page-head">
    <div>
        <div class="u-eyebrow">Staff</div>
        <h1>Lending desk</h1>
        <p>You are logged in as the librarian, so <em>your</em> token says nothing about the student.
            Enrollment is checked live with the Secretariat.</p>
    </div>
</div>

<div class="row g-4 mb-2">
    <div class="col-lg-6">
        <form method="post" class="card h-100">
            <div class="card-header">@Icons.Svg("counter") Lend a book</div>
            <div class="card-body">
                <div class="mb-3">
                    <label asp-for="StudentId" class="form-label">Student ID (from the student card)</label>
                    <input asp-for="StudentId" class="form-control u-id" placeholder="S2026001" required />
                </div>
                <div class="mb-1">
                    <label asp-for="BookId" class="form-label">Book</label>
                    <select asp-for="BookId" class="form-select"
                            asp-items="@(new SelectList(Model.Books, nameof(Book.Id), nameof(Book.Title)))"></select>
                </div>
            </div>
            <div class="card-footer d-flex flex-wrap gap-2">
                <button type="submit" asp-page-handler="Lend" class="btn btn-success">Check enrollment and lend</button>
                <button type="submit" asp-page-handler="Check" class="btn btn-outline-secondary">Only check enrollment</button>
            </div>
        </form>
    </div>

    <div class="col-lg-6">
        <div class="card h-100 @(check is null ? "" : check.Allowed ? "border-success" : "border-danger")">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>@Icons.Svg("server") Last answer from the Secretariat API</span>
                @if (check?.Status is not null)
                {
                    <span class="u-pill @(check.Allowed ? "u-pill-success" : "u-pill-danger")">@check.Status</span>
                }
            </div>
            <div class="card-body">
                @if (check is null)
                {
                    <p class="text-muted small mb-3">Nothing checked yet. When you press a button, Biblioteca:</p>
                    <ol class="u-steps">
                        <li>gets a token for <strong>itself</strong> from Keycloak (<code>grant_type=client_credentials</code>,
                            client <code>biblioteca</code>);</li>
                        <li>calls <code>GET http://localhost:5001/api/students/{id}/enrollment</code> with it;</li>
                        <li>the Secretariat checks <code>aud</code> = <code>secretariat-api</code> and role
                            <code>enrollment.read</code>, then answers from its database.</li>
                    </ol>
                }
                else
                {
                    <p class="mb-2 small">
                        <code>GET /api/students/@Model.CheckedStudentId/enrollment</code> →
                        <strong>@(check.HttpStatus == 0 ? "no response" : check.HttpStatus.ToString())</strong>
                    </p>
                    <pre class="u-code" style="border-radius: 10px;">@check.Response</pre>
                }
            </div>
        </div>
    </div>
</div>

<h2 class="u-section-title">Books currently out</h2>
@if (Model.ActiveLoans.Count == 0)
{
    <div class="card p-4 text-center text-muted">None.</div>
}
else
{
    <div class="card u-table-card">
        <table class="table align-middle">
            <thead><tr><th>Book</th><th>Student</th><th>Due</th><th>Channel</th><th>Evidence</th><th></th></tr></thead>
            <tbody>
            @foreach (var l in Model.ActiveLoans)
            {
                <tr>
                    <td class="fw-semibold">@l.Book.Title</td>
                    <td>
                        <div class="u-person">
                            <span class="u-avatar">@Icons.Initials(l.BorrowerName)</span>
                            <div><div class="u-name">@l.BorrowerName</div><div class="u-sub u-id">@l.StudentId</div></div>
                        </div>
                    </td>
                    <td><span class="u-pill @(l.DueAtUtc < DateTime.UtcNow ? "u-pill-danger" : "u-pill-accent")">@l.DueAtUtc.ToLocalTime().ToString("yyyy-MM-dd")</span></td>
                    <td><span class="u-pill u-pill-muted plain">@l.Channel</span></td>
                    <td class="small">@l.EnrollmentEvidence</td>
                    <td class="text-end">
                        <form method="post" asp-page-handler="Return" asp-route-loanId="@l.Id" class="m-0">
                            <button class="btn btn-sm btn-outline-success">@Icons.Svg("check") Returned</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
