@inject Microsoft.Extensions.Configuration.IConfiguration Config
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Biblioteca</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/_content/Universitate.Shared/css/universitate.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
@{
    var page = ViewContext.RouteData.Values["page"] as string ?? "";
    string Active(string p) => page.Equals(p, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<body class="app-biblioteca">
    <div class="u-topbar">
        <div class="container">
            <span class="u-uni">@Icons.Svg("university") Universitatea (demo)</span>
            <nav class="u-apps" aria-label="University applications">
                <a href="@Config["Links:Secretariat"]">Secretariat</a>
                <a class="current" href="@Config["Links:Biblioteca"]">Biblioteca</a>
            </nav>
        </div>
    </div>
    <header class="u-header">
        <nav class="navbar navbar-expand-md">
            <div class="container">
                <a class="u-brand me-4" href="/">
                    <span class="u-logo">@Icons.Svg("book", "")</span>
                    <span>
                        <span class="u-brand-name d-block">Biblioteca</span>
                        <span class="u-brand-sub d-block">University library</span>
                    </span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav"
                        aria-controls="nav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div id="nav" class="collapse navbar-collapse">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link @Active("/Index")" asp-page="/Index">Catalog</a></li>
                        @if (User.IsInRole("reader"))
                        {
                            <li class="nav-item"><a class="nav-link @Active("/MyLoans")" asp-page="/MyLoans">My loans</a></li>
                        }
                        @if (User.IsInRole("librarian"))
                        {
                            <li class="nav-item"><a class="nav-link @Active("/Desk/Index")" asp-page="/Desk/Index">Lending desk</a></li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <main role="main" class="u-main">
        <div class="container">
            @if (TempData["Message"] is string message)
            {
                <div class="alert alert-success">@message</div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="alert alert-danger">@error</div>
            }
            @RenderBody()
        </div>
    </main>
    <footer class="u-footer">
        <div class="container">
            <span>Biblioteca · demo application of the identity course · sign-in by Keycloak, realm <code>universitate</code></span>
            <span>Enrollment data owned by the <a href="@Config["Links:Secretariat"]">Secretariat</a></span>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
