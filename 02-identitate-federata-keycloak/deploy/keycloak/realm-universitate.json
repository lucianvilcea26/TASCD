{
  "realm": "universitate",
  "displayName": "Universitate (demo)",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "accessTokenLifespan": 120,
  "ssoSessionIdleTimeout": 1800,
  "actionTokenGeneratedByAdminLifespan": 259200,
  "eventsEnabled": true,
  "eventsExpiration": 604800,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "noreply@universitate.local",
    "fromDisplayName": "Universitate",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "roles": {
    "client": {
      "secretariat": [
        {
          "name": "secretary",
          "description": "Secretariat staff: manages students"
        },
        {
          "name": "student",
          "description": "Student: sees own record"
        }
      ],
      "biblioteca": [
        {
          "name": "librarian",
          "description": "Library staff: lends and receives books at the desk"
        },
        {
          "name": "reader",
          "description": "Can borrow books self-service"
        }
      ],
      "secretariat-api": [
        {
          "name": "enrollment.read",
          "description": "May ask the Secretariat API whether a student is enrolled"
        }
      ]
    }
  },
  "groups": [
    {
      "name": "studenti",
      "path": "/studenti",
      "clientRoles": {
        "secretariat": [
          "student"
        ],
        "biblioteca": [
          "reader"
        ]
      }
    }
  ],
  "clients": [
    {
      "clientId": "secretariat",
      "name": "Secretariat",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "secretariat-secret-change-me",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "rootUrl": "http://localhost:5001",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost:5001/signin-oidc",
        "http://localhost:5001/"
      ],
      "webOrigins": [
        "http://localhost:5001"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5001/signout-callback-oidc",
        "backchannel.logout.url": "http://host.docker.internal:5001/backchannel-logout",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "false"
      },
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "organization",
        "offline_access",
        "microprofile-jwt",
        "kc-admin-api"
      ],
      "protocolMappers": [
        {
          "name": "secretariat client roles -> roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true",
            "usermodel.clientRoleMapping.clientId": "secretariat",
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true"
          }
        },
        {
          "name": "student_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true",
            "user.attribute": "student_id",
            "claim.name": "student_id",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "clientId": "biblioteca",
      "name": "Biblioteca",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "biblioteca-secret-change-me",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "rootUrl": "http://localhost:5002",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost:5002/signin-oidc",
        "http://localhost:5002/"
      ],
      "webOrigins": [
        "http://localhost:5002"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5002/signout-callback-oidc",
        "backchannel.logout.url": "http://host.docker.internal:5002/backchannel-logout",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "false"
      },
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "organization",
        "offline_access",
        "microprofile-jwt"
      ],
      "protocolMappers": [
        {
          "name": "biblioteca client roles -> roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true",
            "usermodel.clientRoleMapping.clientId": "biblioteca",
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true"
          }
        },
        {
          "name": "student_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true",
            "user.attribute": "student_id",
            "claim.name": "student_id",
            "jsonType.label": "String"
          }
        },
        {
          "name": "enrollment_status",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true",
            "user.attribute": "enrollment_status",
            "claim.name": "enrollment_status",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "clientId": "secretariat-api",
      "name": "Secretariat API (resource server)",
      "description": "No logins. Defines the API's roles and is the audience of tokens sent to it.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "not-used",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    }
  ],
  "clientScopeMappings": {
    "realm-management": [
      {
        "client": "secretariat",
        "roles": [
          "manage-users",
          "view-users",
          "query-users",
          "query-groups"
        ]
      }
    ],
    "secretariat-api": [
      {
        "client": "biblioteca",
        "roles": [
          "enrollment.read"
        ]
      }
    ]
  },
  "users": [
