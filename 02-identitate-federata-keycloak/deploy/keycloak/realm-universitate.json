          "librarian"
        ]
      }
    },
    {
      "username": "service-account-secretariat",
      "enabled": true,
      "serviceAccountClientId": "secretariat",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users",
          "query-groups"
        ]
      }
    },
    {
      "username": "service-account-biblioteca",
      "enabled": true,
      "serviceAccountClientId": "biblioteca",
      "clientRoles": {
        "secretariat-api": [
          "enrollment.read"
        ]
      }
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"validations\": {\"length\": {\"min\": 3, \"max\": 255}, \"username-prohibited-characters\": {}, \"up-username-not-idn-homograph\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false}, {\"name\": \"email\", \"displayName\": \"${email}\", \"validations\": {\"email\": {}, \"length\": {\"max\": 255}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false}, {\"name\": \"student_id\", \"displayName\": \"Student ID (nr. matricol)\", \"group\": \"academic\", \"validations\": {\"pattern\": {\"pattern\": \"^[A-Z][0-9]{7}$\", \"error-message\": \"Format: one capital letter + 7 digits\"}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false}, {\"name\": \"enrollment_status\", \"displayName\": \"Enrollment status\", \"group\": \"academic\", \"validations\": {\"options\": {\"options\": [\"enrolled\", \"suspended\", \"graduated\"]}}, \"annotations\": {\"inputType\": \"select\"}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false}, {\"name\": \"faculty\", \"displayName\": \"Faculty\", \"group\": \"academic\", \"validations\": {\"length\": {\"max\": 100}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false}], \"groups\": [{\"name\": \"user-metadata\", \"displayHeader\": \"User metadata\", \"displayDescription\": \"Attributes, which refer to user metadata\"}, {\"name\": \"academic\", \"displayHeader\": \"Academic data\", \"displayDescription\": \"Owned by the Secretariat application; users can see but not change it\"}]}"
          ]
        }
      }
    ]
  }
}
