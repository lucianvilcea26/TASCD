@model IEnumerable<IdentityRecord>
@{
    ViewData["Title"] = "Secretariat";
    var today = DateOnly.FromDateTime(DateTime.Today);
}

<h1>Secretariat <small class="text-muted">(simulat)</small></h1>

<table class="table">
    <thead>
        <tr><th>Matricol</th><th>Nume</th><th>Program</th><th>Înmatriculare</th></tr>
    </thead>
    <tbody>
        @foreach (var student in Model)
        {
            var enrollment = student.Attributes.First(a => a.Name == "înmatriculare");
            <tr>
                <td>@student.IdentifierIn(Contexts.Secretariat)</td>
                <td>@student.Attribute("nume")</td>
                <td>@student.Attribute("program")</td>
                <td>
                    @enrollment.Value până la @enrollment.ValidUntil?.ToString("dd.MM.yyyy")
                    @if (!enrollment.IsValidOn(today))
                    {
                        <span class="badge bg-danger">expirată</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
