@model IEnumerable<IdentityRecord>
@{
    ViewData["Title"] = "Cititori";
}

<h1>Cititori</h1>

<table class="table">
    <thead>
        <tr><th>Permis</th><th>Nume</th><th>Categorie</th><th>Număr matricol</th></tr>
    </thead>
    <tbody>
        @foreach (var reader in Model)
        {
            <tr>
                <td><a asp-action="Details" asp-route-id="@reader.IdentifierIn(Contexts.Biblioteca)">@reader.IdentifierIn(Contexts.Biblioteca)</a></td>
                <td>@reader.Attribute("nume")</td>
                <td>@reader.Attribute("categorie")</td>
                <td>@(reader.IdentifierIn(Contexts.Secretariat) ?? "–")</td>
            </tr>
        }
    </tbody>
</table>
