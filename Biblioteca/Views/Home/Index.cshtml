@{
    ViewData["Title"] = "Acasă";
}

<div class="text-center">
    <h1 class="display-4">Biblioteca ASE</h1>
    <p>Catalogul și împrumuturile bibliotecii universitare.</p>

<form asp-controller="Readers" asp-action="Find" method="get" class="row g-2 justify-content-center mt-4">
    <div class="col-auto">
        <input name="card" class="form-control" placeholder="Număr de permis, de ex. B-0137" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Caută cititorul</button>
    </div>
</form>
</div>
